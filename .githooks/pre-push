# Before pushing, run ops/ci_check.sh for every commit about to be pushed in a temporary
# worktree. This mirrors .github/workflows/tests.yml so CI results are known locally.
#
# Check the commit, not the working tree: even with unrelated local changes, validate the tree that will be pushed.
#
# Emergency bypass:
#   COMICINE_SKIP_CI_CHECK=1 git push
# The same commit already checked by deploy.sh is skipped automatically (COMICINE_CI_CHECKED_SHA).

set -uo pipefail

_COMICINE_SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ -r "$_COMICINE_SCRIPT_DIR/env_compat.sh" ]]; then
    source "$_COMICINE_SCRIPT_DIR/env_compat.sh"
elif [[ -r "$_COMICINE_SCRIPT_DIR/../ops/env_compat.sh" ]]; then
    source "$_COMICINE_SCRIPT_DIR/../ops/env_compat.sh"
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if [ "${COMICINE_SKIP_CI_CHECK:-0}" = 1 ]; then
    echo "[pre-push] COMICINE_SKIP_CI_CHECK=1; skipping the local CI check" >&2
    exit 0
fi

CHECKED_SHA="${COMICINE_CI_CHECKED_SHA:-}"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    if [ "$local_sha" = "$CHECKED_SHA" ]; then
        echo "[pre-push] $local_sha was already checked by deploy.sh; skipping" >&2
        continue
    fi
    echo "[pre-push] checking ${local_ref} -> ${remote_ref} (${local_sha})" >&2
    if ! bash ops/ci_check.sh --ref="$local_sha"; then
        echo "[pre-push] push rejected: the commit failed the local CI check; fix it before pushing" >&2
        status=1
    fi
done

exit "$status"
