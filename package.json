{
  "name": "comicine-functions-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ComiCine Cloudflare Pages Functions unit tests",
  "scripts": {
    "test": "vitest run && node --test ops/image-watermark/src/index.test.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "build": "bash ops/build.sh"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.152.0"
  },
  "license": "AGPL-3.0-or-later",
  "overrides": {
    "undici": "7.30.1"
  }
}
