# Python
__pycache__/
.pytest_cache/
.ruff_cache/

# Python coverage artifacts (pytest-cov / vitest --coverage)
.coverage
.coverage.*
coverage/
htmlcov/

# macOS
.DS_Store

# Local development files
chrome.txt
node_modules

# Claude Code configuration
.claude/

# Local D1 migration state (not tracked; apply records are machine-specific)
.d1-migrations/

# Local Cloudflare Pages secrets
.dev.vars
.dev.vars.example

# Local Wrangler runtime cache
.wrangler/

# Large dependency backups left by npm recovery; excluded by this rule (see docs/22 W8-2)
node_modules.recovery-*

# Local Pages build environment (generated, not tracked; includes iCloud conflict copies such as ".venv-build 2")
.venv-build*/

# Pages build output (keep only the placeholder file)
public/*
!public/.gitkeep

# Subdomain previews (generated for local preview only)
preview/*
!preview/.gitkeep

# Portfolio originals (large and not tracked; kept locally and in the private limooo-originals R2 bucket)
src/static/portfolio/

# Migration exports (may contain sensitive data such as encrypted passwords; never track)
ops/out/

# Runtime databases (generated by the server)
*.db
*.db-shm
*.db-wal

# Keys and certificates (never track private keys or tokens; use Secrets or local secrets/)
secrets/
*.pem
*.key

# GeoIP databases (large and not tracked)
*.mmdb

# Local operations files
各种密钥.txt
Logs/
data/*.log

# Server reset backups (database dumps and similar files; never track)
backup-limooo-*/
ops/backups/
